/**
 * NutritionLabel - displays nutrition facts in a 2-column format
 * Maps all 18 nutrition fields to USDA label order
 *
 * When nutritionAlternatives are provided, a horizontal row of toggle
 * buttons appears above the label allowing the user to switch between
 * the primary serving and each alternative.
 */

import React, { useState } from 'react';
import {
  ScrollView,
  Text,
  View,
  TouchableOpacity,
} from 'react-native';
import { INutrition, INutritionAlternative } from '@/types/food';

// Map INutrition field names to display labels in USDA order
// Structured serving fields are intentionally omitted — they are rendered
// in the Serving Size row instead of as individual rows.
const NUTRITION_FIELD_LABELS: Partial<Record<keyof INutrition, string>> = {
  serving_size_description: 'Serving Size',
  calories: 'Calories',
  total_fat_g: 'Total Fat (g)',
  saturated_fat_g: 'Saturated Fat (g)',
  trans_fat_g: 'Trans Fat (g)',
  cholesterol_mg: 'Cholesterol (mg)',
  sodium_mg: 'Sodium (mg)',
  total_carbs_g: 'Total Carbs (g)',
  fiber_g: 'Dietary Fiber (g)',
  total_sugar_g: 'Total Sugar (g)',
  added_sugar_g: 'Added Sugar (g)',
  protein_g: 'Protein (g)',
  vitamin_d_mcg: 'Vitamin D (mcg)',
  calcium_mg: 'Calcium (mg)',
  iron_mg: 'Iron (mg)',
  potassium_mg: 'Potassium (mg)',
};

const formatValue = (value: any): string => {
  if (value === null || value === undefined) {
    return '—';
  }
  if (typeof value === 'string') {
    return value;
  }
  if (typeof value === 'number') {
    return value.toLocaleString();
  }
  return '—';
};

const buildAlternativeLabel = (alt: INutritionAlternative): string => {
  const parts: string[] = [];
  if (alt.serving_value) {
    parts.push(formatValue(alt.serving_value));
  }
  if (alt.serving_unit) {
    parts.push(alt.serving_unit);
  }
  return parts.length > 0 ? parts.join(' ') : 'Alt';
};

interface NutritionLabelProps {
  nutrition: INutrition;
  servings?: number;
  servingSizeG?: number;
  servingSizeOz?: number;
  servingSizeDescription?: string;
  excludeFields?: Array<keyof INutrition>;
  showServingSizeRow?: boolean;
  emphasizeCalories?: boolean;
  trailingRows?: Array<{ label: string; value: string }>;
  nutritionAlternatives?: INutritionAlternative[];
}

export const NutritionLabel: React.FC<NutritionLabelProps> = ({
  nutrition,
  servings,
  servingSizeG,
  servingSizeOz,
  servingSizeDescription,
  excludeFields,
  showServingSizeRow = true,
  emphasizeCalories = false,
  trailingRows,
  nutritionAlternatives,
}) => {
  // -1 = primary, 0+ = alternative index
  const [selectedIndex, setSelectedIndex] = useState(-1);

  const hasAlternatives =
    nutritionAlternatives && nutritionAlternatives.length > 0;

  const activeNutrition: INutrition =
    selectedIndex >= 0 && hasAlternatives
      ? nutritionAlternatives![selectedIndex].nutrition
      : nutrition;

  const allFields: Array<keyof INutrition> = [
    'serving_size_oz',
    'serving_size_g',
    'calories',
    'total_fat_g',
    'saturated_fat_g',
    'trans_fat_g',
    'cholesterol_mg',
    'sodium_mg',
    'total_carbs_g',
    'fiber_g',
    'total_sugar_g',
    'added_sugar_g',
    'protein_g',
    'vitamin_d_mcg',
    'calcium_mg',
    'iron_mg',
    'potassium_mg',
  ];

  const fields = excludeFields
    ? allFields.filter((field) => !excludeFields.includes(field))
    : allFields;

  // Prefer structured serving fields when available; fall back to legacy oz/g
  const structuredServing =
    activeNutrition.serving_value != null && activeNutrition.serving_unit
      ? `${formatValue(activeNutrition.serving_value)} ${activeNutrition.serving_unit}`
      : null;
  const legacyServing = [
    servingSizeOz != null ? `${formatValue(servingSizeOz)} oz` : null,
    servingSizeG != null ? `${formatValue(servingSizeG)} g` : null,
  ]
    .filter(Boolean)
    .join(', ');

  const servingSizeValue = [
    servingSizeDescription || activeNutrition.serving_size_description,
    structuredServing ?? legacyServing,
  ]
    .filter((part) => part && part !== '—')
    .join(', ');

  const primaryLabel = structuredServing ?? legacyServing ?? 'Primary';

  return (
    <ScrollView style={{ paddingHorizontal: 16, paddingVertical: 12 }}>
      {/* Serving view switcher */}
      {hasAlternatives && (
        <ScrollView
          horizontal
          showsHorizontalScrollIndicator={false}
          style={{ marginBottom: 12 }}
          contentContainerStyle={{ gap: 8, paddingHorizontal: 2 }}
        >
          <TouchableOpacity
            onPress={() => setSelectedIndex(-1)}
            style={{
              backgroundColor: selectedIndex === -1 ? '#007AFF' : '#e8e8e8',
              borderRadius: 16,
              paddingHorizontal: 12,
              paddingVertical: 6,
            }}
          >
            <Text
              style={{
                fontSize: 12,
                color: selectedIndex === -1 ? '#fff' : '#333',
                fontWeight: '600',
              }}
              numberOfLines={1}
            >
              {primaryLabel}
            </Text>
          </TouchableOpacity>
          {nutritionAlternatives!.map((alt, idx) => (
            <TouchableOpacity
              key={alt.id || idx}
              onPress={() => setSelectedIndex(idx)}
              style={{
                backgroundColor: selectedIndex === idx ? '#007AFF' : '#e8e8e8',
                borderRadius: 16,
                paddingHorizontal: 12,
                paddingVertical: 6,
              }}
            >
              <Text
                style={{
                  fontSize: 12,
                  color: selectedIndex === idx ? '#fff' : '#333',
                  fontWeight: '600',
                }}
                numberOfLines={1}
              >
                {buildAlternativeLabel(alt)}
              </Text>
            </TouchableOpacity>
          ))}
        </ScrollView>
      )}

      {servings != null && (
        <View
          style={{
            flexDirection: 'row',
            justifyContent: 'space-between',
            paddingVertical: 8,
            borderBottomWidth: 1,
            borderBottomColor: '#e0e0e0',
          }}
        >
          <Text style={{ fontSize: 14, color: '#333', flex: 1 }}>
            Servings
          </Text>
          <Text style={{ fontSize: 14, color: '#333', fontWeight: '600' }}>
            {formatValue(servings)}
          </Text>
        </View>
      )}

      {showServingSizeRow && (
        <View
          style={{
            flexDirection: 'row',
            justifyContent: 'space-between',
            paddingVertical: 8,
            borderBottomWidth: 1,
            borderBottomColor: '#e0e0e0',
          }}
        >
          <Text style={{ fontSize: 14, color: '#333', flex: 1 }}>
            Serving Size
          </Text>
          <Text style={{ fontSize: 14, color: '#333', fontWeight: '600' }}>
            {servingSizeValue || '—'}
          </Text>
        </View>
      )}

      {fields.map((field) => (
        <View
          key={field}
          style={{
            flexDirection: 'row',
            justifyContent: 'space-between',
            paddingVertical: 8,
            borderBottomWidth: 1,
            borderBottomColor: '#e0e0e0',
          }}
        >
          <Text
            style={{
              fontSize: emphasizeCalories && field === 'calories' ? 16 : 14,
              color: '#333',
              flex: 1,
              fontWeight:
                emphasizeCalories && field === 'calories' ? '700' : '400',
            }}
          >
            {NUTRITION_FIELD_LABELS[field]}
          </Text>
          <Text
            style={{
              fontSize: emphasizeCalories && field === 'calories' ? 16 : 14,
              color: '#333',
              fontWeight:
                emphasizeCalories && field === 'calories' ? '800' : '600',
            }}
          >
            {formatValue(activeNutrition[field])}
          </Text>
        </View>
      ))}

      {trailingRows?.map((row) => (
        <View
          key={row.label}
          style={{
            flexDirection: 'row',
            justifyContent: 'space-between',
            paddingVertical: 8,
            borderBottomWidth: 1,
            borderBottomColor: '#e0e0e0',
          }}
        >
          <Text style={{ fontSize: 14, color: '#333', flex: 1 }}>
            {row.label}
          </Text>
          <Text style={{ fontSize: 14, color: '#333', fontWeight: '600' }}>
            {row.value}
          </Text>
        </View>
      ))}
    </ScrollView>
  );
};